DATABASE_URL=sqlite+aiosqlite:///./smartlearner.db
SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=55
SMART_MODEL=llama-3.3-70b-versatile

# separate Groq key used only by validator agents (placement/QA/lesson checks that call the API).
# If unset, validators fall back to GROQ_API_KEY.
GROQ_API_KEY_VALIDATORS=44
FAST_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_db
SOURCE_RESOURCE=Python for Everybody (University of Michigan; Coursera) — https://www.coursera.org/specializations/python
SOURCE_SCOPE=Open textbook & materials: https://www.py4e.com/ | Track: Python Foundations
