# Local dev (per machine): SQLite
DATABASE_URL=sqlite+aiosqlite:///./smartlearner.db
# Supabase: see backend/SUPABASE-SETUP.md — URL must use driver asyncpg, e.g.:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.xxxxx.supabase.co:5432/postgres
# (Use “Direct” / port 5432 in the Supabase dashboard for a long-running FastAPI process.)
# Same idea for other hosts:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: DATABASE_SSL=false for local PostgreSQL without TLS
# If SSL cert verify fails to Supabase (common on some Windows setups): DATABASE_SSL_VERIFY=false
# When the React app is hosted (Vercel, etc.), add its origin so the browser can call the API:
# CORS_EXTRA_ORIGINS=https://my-app.vercel.app
SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Required for placement, lessons, QA, etc. Create at https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
SMART_MODEL=llama-3.3-70b-versatile
# Optional: separate key for validator-only calls. If empty, GROQ_API_KEY is used.
GROQ_API_KEY_VALIDATORS=
FAST_MODEL=llama-3.1-8b-instant
# QA_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_db
SOURCE_RESOURCE=Python for Everybody (University of Michigan; Coursera) — https://www.coursera.org/specializations/python
SOURCE_SCOPE=Open textbook & materials: https://www.py4e.com/ | Track: Python Foundations
